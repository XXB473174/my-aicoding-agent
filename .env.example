# 环境变量模板：复制为 .env 后填写真实值，.env 不会进入仓库。
# 只填写必填项即可启动；其余为可选调优项。

# ===== 必填：DeepSeek 模型 =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MAIN_MODEL=deepseek-v4-pro

# ===== 必填：Gitee 私人令牌（需要仓库读、写、提交和创建 PR 权限）=====
GITEE_TOKEN=
GITEE_API_BASE_URL=https://gitee.com/api/v5

# ===== 建议显式配置：工作区与数据目录 =====
# 工作区不能指向项目源码目录，否则 Agent 可能改动本项目自身。
AI_WORKSPACE_ROOT=
LX_AICODING_DATA_DIR=
LX_AICODING_LOG_DIR=

# ===== 可选：联网搜索（智谱）=====
ZHIPU_API_KEY=

# ===== 可选：模型与日志调优 =====
# INTENT_MODEL=
# INTENT_MODEL_TEMPERATURE=0
# INTENT_MODEL_MAX_TOKENS=200
LX_AICODING_LOG_LEVEL=INFO
LX_AICODING_LOG_RETENTION_DAYS=14

# ===== 可选：单轮运行保护上限 =====
# AGENT_MAX_TOOL_CALLS=240
# AGENT_MAX_SECONDS=1800
# AGENT_CODING_MAX_TOOL_CALLS=300
# AGENT_CODING_MAX_SECONDS=1800
